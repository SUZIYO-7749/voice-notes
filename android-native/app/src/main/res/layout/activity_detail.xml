<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/app_name"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <EditText
                android:id="@+id/edit_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/detail_title_hint"
                android:inputType="text"
                android:maxLines="1"
                android:background="@android:color/transparent"
                android:textColor="@color/text"
                android:textSize="21sp"
                android:textStyle="bold"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btn_fav"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/fav_add"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_star" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <!-- 播放器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_accent"
                android:contentDescription="@string/app_name"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play" />

            <com.voicenotes.nativeapp.WaveView
                android:id="@+id/wave_detail"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="14dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:fontFamily="monospace"
                android:text="0:00"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 文字稿 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/detail_transcript" />

        <EditText
            android:id="@+id/edit_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:gravity="top|left"
            android:hint="@string/detail_transcript_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="6"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/text_dictate_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_dictate"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="@string/detail_dictate" />

            <Button
                android:id="@+id/btn_copy"
                style="@style/Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:text="@string/detail_copy" />

            <Button
                android:id="@+id/btn_clear"
                style="@style/Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:text="@string/detail_clear" />
        </LinearLayout>

        <!-- 标签 -->
        <TextView
            style="@style/SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/detail_tags" />

        <EditText
            android:id="@+id/edit_tags"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input"
            android:hint="@string/detail_tags_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:importantForAutofill="no" />

        <!-- 操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_export"
                style="@style/Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/detail_export" />

            <Button
                android:id="@+id/btn_delete"
                style="@style/Button.Danger"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="@string/detail_delete" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
